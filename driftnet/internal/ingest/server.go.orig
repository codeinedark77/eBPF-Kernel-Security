// Package ingest hosts the WebSocket endpoint that Frida agents stream
// events into. Designed to be reached over a Tailscale tailnet address,
// so it deliberately does NOT do its own TLS/auth — the tailnet is the
// trust boundary. Do not expose this port outside the tailnet.
package ingest

import (
	"encoding/json"
	"fmt"
	"log"
	"net/http"
	"time"

	"github.com/gorilla/websocket"

	"github.com/yash/driftnet/internal/attribution"
	"github.com/yash/driftnet/internal/fingerprint"
	"github.com/yash/driftnet/internal/novelty"
	"github.com/yash/driftnet/internal/rules"
	"github.com/yash/driftnet/internal/store"
)

// RawEvent is what the Frida agent sends over the wire, before scoring.
type RawEvent struct {
	Device     string          `json:"device"`
	App        string          `json:"app"`
	Kind       string          `json:"kind"`
	Detail     json.RawMessage `json:"detail"`
	AppVersion string          `json:"app_version,omitempty"`
}

// NoveltyThreshold is the novelty score above which an event gets flagged
// for triage.
//
// HISTORY: two real bugs found and fixed during testing, not papered over
// with threshold tuning -- full detail in internal/novelty's package doc:
//  1. Scorer denominator scaled with baseline size -> scores drifted
//     toward 1 as the window filled, regardless of similarity.
//  2. The fix for #1 (marginal-cost diffing) introduced compressor
//     block-boundary noise that also drifted with baseline size.
//     Replaced with dictionary-assisted single-shot compression, which a
//     controlled test confirmed stays flat across baseline growth.
//  3. Separately: magnitude anomalies (a byte count going from 341 to
//     4.8M) were invisible to a raw-JSON compressor because the event's
//     lexical shape barely changed -- fixed by scoring
//     fingerprint.Enrich(detail) instead of raw bytes (see
//     internal/fingerprint).
//
// CALIBRATED VALUES from the final smoke test (60 baseline events, 3
// injected anomalies) after all three fixes: steady-state baseline
// traffic scores 0.20-0.26; a DES/ECB cipher swap scores 1.0; a write to
// a suspiciously-named file scores 0.93; a 4.8MB exfil-shaped POST to an
// unfamiliar host scores 0.54 -- right at the edge of a naive 0.55 cutoff
// because its JSON *shape* (same keys as every other network event) is
// still fairly ordinary even with the magnitude bucket added. 0.5 gives
// that case room to flag while keeping a wide margin over baseline noise.
// Re-tune against real traffic, not synthetic events, once this is
// actually running against the phone.
const NoveltyThreshold = 0.5

// ScoringKey builds the key novelty.Manager uses to separate baselines.
// Deliberately includes kind, unlike the device:app key used for rules
// and event storage -- see the "per-kind baseline scoping" note below for
// why. Exported so main.go's WAL-replay warmup path builds identical keys
// to live ingest; if the two ever drifted apart, replay warmup would
// silently rebuild baselines under the wrong keys and have zero effect,
// same failure shape as the fingerprint.Enrich/threshold-drift bugs found
// earlier in this project.
func ScoringKey(device, app, kind string) string {
	return device + ":" + app + ":" + kind
}

type Server struct {
	wal              *store.WAL
	scorers          *novelty.Manager
	secondaryScorers *novelty.SecondaryManager
	rules            *rules.Evaluator
	upgrader         websocket.Upgrader

	// OnEvent is called synchronously for every successfully ingested
	// event, regardless of novelty score. Wire this to feed the
	// dashboard's full recent-activity view.
	OnEvent func(ev *store.Event)

	// OnFlagged is called (non-blocking, in a goroutine) whenever an
	// event's NCD score crosses NoveltyThreshold, a rule matched, OR the
	// primary and secondary compressor-based scores disagree about
	// whether this event is novel (see SecondaryNoveltyThreshold).
	// Wire this to the triage worker to get an LLM explanation of why
	// something was flagged.
	OnFlagged func(ev *store.Event)
}

// SecondaryNoveltyThreshold is the flag threshold for the independent
// DEFLATE-based secondary scorer (see novelty/secondary.go). Reuses the
// same numeric value as the primary zstd-based NoveltyThreshold as a
// starting assumption: synthetic calibration testing showed DEFLATE's
// steady-state baseline sits lower (0.09-0.13) than zstd's (0.20-0.28)
// and its anomaly reading (0.55-0.56) comfortably clears 0.5 the same
// way zstd's does -- so reusing the number avoids introducing a second
// blindly-guessed magic constant. Like NoveltyThreshold's own history,
// this needs recalibration against real traffic, not synthetic events.
const SecondaryNoveltyThreshold = 0.5

// NewServer takes rulesEvaluator as a parameter rather than constructing
// one internally, so main.go can hold the same instance and warm its
// state (event counts, seen-hosts) from WAL replay on startup -- an
// internally-constructed Evaluator would start fresh on every restart,
// flooding "first seen" flags for hosts a source had already established
// long before. See rules.Evaluator.ObserveOnly's doc for that fix.
func NewServer(wal *store.WAL, scorers *novelty.Manager, secondaryScorers *novelty.SecondaryManager, rulesEvaluator *rules.Evaluator) *Server {
	return &Server{
		wal:              wal,
		scorers:          scorers,
		secondaryScorers: secondaryScorers,
		rules:            rulesEvaluator,
		upgrader: websocket.Upgrader{
			ReadBufferSize:  4096,
			WriteBufferSize: 4096,
			// Tailnet is the trust boundary; any origin on the tailnet is fine.
			CheckOrigin: func(r *http.Request) bool { return true },
		},
	}
}

func (s *Server) HandleWS(w http.ResponseWriter, r *http.Request) {
	// NOTE: peek -> attribute -> observe (below) assumes nothing else
	// folds an event into the SAME source's baseline in between. True as
	// long as one source (device:app pair) is only ever instrumented from
	// one connection at a time, which matches driftnet's actual usage
	// pattern (one relay per phone). If the same app were ever
	// instrumented from two simultaneous connections, their peek/observe
	// sequences could interleave and produce the same kind of stale-
	// baseline attribution bug this fix addresses -- just racy instead of
	// guaranteed. Not fixed here (would need a per-source lock spanning
	// the whole peek-attribute-observe sequence, not just Manager's
	// internal map lock) since it's not a real scenario for this tool's
	// actual usage today.
	conn, err := s.upgrader.Upgrade(w, r, nil)
	if err != nil {
		log.Printf("ingest: upgrade failed: %v", err)
		return
	}
	defer conn.Close()

	log.Printf("ingest: agent connected from %s", r.RemoteAddr)
	conn.SetReadDeadline(time.Now().Add(90 * time.Second))
	conn.SetPongHandler(func(string) error {
		conn.SetReadDeadline(time.Now().Add(90 * time.Second))
		return nil
	})

	for {
		_, msg, err := conn.ReadMessage()
		if err != nil {
			log.Printf("ingest: agent disconnected: %v", err)
			return
		}

		var raw RawEvent
		if err := json.Unmarshal(msg, &raw); err != nil {
			log.Printf("ingest: bad event payload: %v", err)
			continue
		}

		sourceKey := raw.Device + ":" + raw.App
		// Per-kind, NOT per-device:app -- see ScoringKey's doc. A source's
		// rolling baseline used to mix network, crypto, and filesystem
		// events together despite their JSON shapes having almost nothing
		// in common, which made attribution useless for a kind's first
		// occurrence (every field showed delta ~0, because the compressor
		// couldn't discriminate sub-field importance when the ENTIRE shape
		// was equally alien to a baseline dominated by a different kind).
		// rules.Evaluate below still uses the plain device:app sourceKey --
		// first_seen_host only reads network events' host field, so it has
		// no cross-kind contamination to begin with.
		scoringKey := ScoringKey(raw.Device, raw.App, raw.Kind)
		scoringPayload := fingerprint.Enrich(raw.Detail)

		// PeekScore, NOT ScoreEvent: score against the current baseline
		// without folding this event in yet. This ordering is load-
		// bearing -- see novelty.Manager.PeekScore's doc for the bug this
		// fixes. Attribution (below) must run against this exact
		// pre-fold snapshot, before Observe changes it.
		score, err := s.scorers.PeekScore(scoringKey, scoringPayload)
		if err != nil {
			log.Printf("ingest: scoring error: %v", err)
			continue
		}
		// Independent second measurement (see novelty/secondary.go) --
		// same key convention, same pre-fold-then-observe ordering as
		// the primary scorer, but a completely separate DEFLATE-backed
		// window. secondaryScore is nil-safe (0.0) if secondaryScorers
		// wasn't configured, so this feature can be omitted without
		// touching call sites.
		var secondaryScore float64
		if s.secondaryScorers != nil {
			secondaryScore = s.secondaryScorers.PeekScore(scoringKey, scoringPayload)
		}

		ruleMatches := s.rules.Evaluate(sourceKey, raw.Kind, raw.Detail)
		// Version tracking is independent of kind (a version applies to
		// the whole app, not one event kind), so it uses the plain
		// device:app sourceKey, same as the other cross-kind rule state.
		if changed, previous := s.rules.CheckVersionChange(sourceKey, raw.AppVersion); changed {
			ruleMatches = append(ruleMatches, fmt.Sprintf("app_updated:%s->%s", previous, raw.AppVersion))
		}
		// Disagreement is deliberately its own, narrowly-defined signal:
		// the two independent compression-based measurements land on
		// OPPOSITE sides of their respective thresholds. Not "the scores
		// differ by some amount" (which would fire on routine calibration
		// noise -- synthetic testing showed ~0.07-0.12 baseline
		// disagreement even on ordinary traffic) -- specifically "one
		// caught it, the other didn't," which single-compressor NCD
		// scoring architecturally cannot express at all.
		if s.secondaryScorers != nil {
			primaryFlagged := score >= NoveltyThreshold
			secondaryFlagged := secondaryScore >= SecondaryNoveltyThreshold
			if primaryFlagged != secondaryFlagged {
				ruleMatches = append(ruleMatches, fmt.Sprintf("compressor_disagreement:zstd=%.3f,deflate=%.3f", score, secondaryScore))
			}
		}
		flagged := score >= NoveltyThreshold || len(ruleMatches) > 0

		var attrs []attribution.FieldAttribution
		if flagged {
			peek := func(b []byte) (float64, error) { return s.scorers.PeekScore(scoringKey, b) }
			attrs, err = attribution.Explain(raw.Detail, fingerprint.Enrich, peek, score)
			if err != nil {
				// Non-object detail or a peek failure -- don't block
				// ingesting the event over a failed explanation. The
				// score and rule matches are still useful on their own.
				log.Printf("ingest: attribution failed for a flagged event (device=%s app=%s kind=%s): %v", raw.Device, raw.App, raw.Kind, err)
				attrs = nil
			}
		}

		// Fold the real event into the baseline now, AFTER scoring and
		// attribution are both done against the pre-fold snapshot.
		if err := s.scorers.Observe(scoringKey, scoringPayload); err != nil {
			log.Printf("ingest: observe failed: %v", err)
			continue
		}
		if s.secondaryScorers != nil {
			s.secondaryScorers.Observe(scoringKey, scoringPayload)
		}

		ev := &store.Event{
			Device:         raw.Device,
			App:            raw.App,
			Kind:           raw.Kind,
			Detail:         raw.Detail,
			AppVersion:     raw.AppVersion,
			NCDScore:       score,
			SecondaryScore: secondaryScore,
			RuleMatches:    ruleMatches,
			Attribution:    attrs,
		}

		if err := s.wal.Append(ev); err != nil {
			log.Printf("ingest: wal append failed: %v", err)
			continue
		}

		if s.OnEvent != nil {
			s.OnEvent(ev)
		}
		if flagged && s.OnFlagged != nil {
			go s.OnFlagged(ev)
		}
	}
}
